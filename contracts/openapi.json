    "/operations/deliveries/{receiptId}/replay": {
      "post": {
        "operationId": "replay-delivery",
        "description": "Requires fos.replay. Only BUSINESS_REJECTED/EXHAUSTED non-operation-status records. UNKNOWN/REMOTE_ACCEPTED require external reconciliation. Token is scoped to actor and bound to receipt and reason.",
        "parameters": [
          {
            "name": "receiptId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "requestToken": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  }
