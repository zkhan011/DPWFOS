<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ include file="operations-header.jspf" %>
<div class="page-title"><div><p class="eyebrow">CONNECTIONS</p><h1>TOS &amp; FMS endpoints</h1><p class="muted">Configure the receivers FOS sends messages to.</p></div></div>
<section class="panel"><h2>How these settings work</h2><p>Save the full receiver URL for each message type. Saved values survive restarts and apply to messages that have not yet been attempted. Retries and requests already in flight keep their original destination.</p><p class="fine">Approved hosts: <strong><c:out value="${allowedHosts}"/></strong>. Your deployment administrator manages this allowlist in <code>fos.allowed-hosts</code>. Credentials stay in server configuration. No test messages are sent when saving.</p><p class="fine">The manual simulator keeps its own destination settings. Built-in SIM- round-trip traffic stays on the isolated simulator receivers when the simulator is available.</p></section>
<div class="module-grid"><c:forEach items="${routes}" var="route"><section class="panel"><p class="eyebrow">FOS → <c:out value="${route.system}"/></p><h2><c:out value="${route.route}"/></h2><p class="fine"><c:out value="${route.origin}"/> · Bearer credential configured: <c:out value="${route.credential_configured ? 'Yes' : 'No'}"/></p>
<form method="post" action="<c:url value='/admin/endpoints/${route.route}'/>"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input type="hidden" name="revision" value="${route.revision}"><label>Receiver endpoint URL<input type="url" name="url" maxlength="1000" value="<c:out value='${route.effective_url}'/>" placeholder="https://receiver.example/api/messages"></label>
<label class="check"><input type="checkbox" name="confirmed" value="true" ${route.effective_confirmed ? 'checked' : ''}> Receiver deduplicates by message ID</label><p class="fine">Confirm this only when agreed with the receiving team. It controls whether FOS may retry an ambiguous HTTP failure.</p>
<label>Reason for change<input name="reason" maxlength="512" required placeholder="e.g. Approved UAT endpoint"></label><div class="editor-actions"><button class="primary" type="submit">Save endpoint</button><button type="submit" name="reset" value="true">Use deployment default</button></div></form><p class="fine">Revision <c:out value="${route.revision}"/> · <c:out value="${route.updated_by}"/> · <c:out value="${route.updated_at}"/></p></section></c:forEach></div>
<%@ include file="operations-footer.jspf" %>
