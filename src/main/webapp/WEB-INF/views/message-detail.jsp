<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ include file="operations-header.jspf" %>
<a class="button" href="<c:url value='/admin/messages'/>">← Message history</a><div class="page-title"><div><p class="eyebrow">MESSAGE DETAILS</p><h1><c:out value="${message.msg_id}"/></h1><p><c:out value="${message.source}"/> → FOS → <c:out value="${message.target}"/></p></div><span class="pill state-${message.state}"><c:out value="${message.state}"/></span></div>
<section class="panel"><dl class="detail-grid"><dt>Receipt</dt><dd><c:out value="${message.receipt_id}"/></dd><dt>Vehicle / type</dt><dd><c:out value="${message.vehicle_id}"/> / <c:out value="${message.message_type}"/></dd><dt>Source timestamp</dt><dd><c:out value="${message.source_timestamp_text}"/></dd><dt>Received at</dt><dd><c:out value="${message.received_at}"/></dd><dt>Completed at</dt><dd><c:out value="${message.completed_at}" default="Not completed"/></dd><dt>Outcome</dt><dd><c:out value="${message.last_outcome}" default="Awaiting delivery"/></dd><dt>Payload SHA-256</dt><dd class="mono"><c:out value="${message.payload_hash}"/></dd></dl>
<c:url var="kafkaLink" value="/admin/kafka"><c:param name="search" value="${message.receipt_id}"/></c:url><a href="<c:out value='${kafkaLink}'/>">Find related Kafka records</a></section>
<section class="panel"><h2>Received / forwarded JSON</h2><p class="fine">FOS forwards the accepted payload unchanged. Known credential fields are masked in JSON previews; retention may remove older payloads.</p><pre><c:out value="${message.display_payload}"/></pre><details><summary>Ingress transport metadata</summary><pre><c:out value="${message.display_metadata}"/></pre></details></section>
<section class="panel"><h2>Delivery attempts &amp; receiver responses</h2><p class="fine">The destination and HTTP response body are captured for attempts made after this upgrade. No response body means no complete bounded response was received, or retention has removed it.</p><c:forEach items="${attempts}" var="attempt"><article class="attempt"><h3>Attempt <c:out value="${attempt.attempt_number}"/> · <c:out value="${attempt.outcome}"/></h3><p class="fine"><c:out value="${attempt.attempted_at}"/> · HTTP <c:out value="${attempt.http_code}" default="—"/> · Business code <c:out value="${attempt.business_code}" default="—"/> · <c:out value="${attempt.duration_ms}"/> ms</p><p class="mono"><c:out value="${attempt.destination}" default="Destination not captured"/></p><details><summary>View receiver response</summary><pre><c:out value="${attempt.display_response}"/></pre></details></article></c:forEach><c:if test="${empty attempts}"><p class="empty">No completed delivery attempts yet. Refresh this page after the workers process the message.</p></c:if></section>
<%@ include file="operations-footer.jspf" %>
