<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>FOS · Operations</title><link rel="stylesheet" href="<c:url value='/admin/assets/style.css'/>"></head><body>
<a class="skip-link" href="#content">Skip to content</a>
<aside class="sidebar"><a class="brand" href="<c:url value='/admin'/>"><span class="brand-mark">F</span><span>FOS<small>INTEGRATION CONSOLE</small></span></a><p class="nav-label">WORKSPACE</p><nav aria-label="Main navigation"><a href="<c:url value='/admin'/>">Overview &amp; simulators</a><a class="${section == 'endpoints' ? 'selected' : ''}" href="<c:url value='/admin/endpoints'/>">Endpoint settings</a><a class="${section == 'messages' ? 'selected' : ''}" href="<c:url value='/admin/messages'/>">Message history</a><a class="${section == 'kafka' ? 'selected' : ''}" href="<c:url value='/admin/kafka'/>">Kafka logs</a></nav><div class="sidebar-bottom">FMS ↔ FOS ↔ TOS</div></aside>
<div class="workspace"><header><span>Operations workspace</span><form method="post" action="<c:url value='/admin/logout'/>"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button>Sign out</button></form></header><main id="content">
<c:if test="${not empty notice}"><div class="notice" role="status"><c:out value="${notice}"/></div></c:if>
