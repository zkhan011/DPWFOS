<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>FOS · Integration console</title><link rel="stylesheet" href="<c:url value='/admin/assets/style.css'/>"></head><body>
<aside class="sidebar"><a class="brand" href="<c:url value='/admin'/>"><span class="brand-mark">F</span><span>FOS<small>INTEGRATION CONSOLE</small></span></a><p class="nav-label">WORKSPACE</p><nav><a href="#overview" class="selected">Overview</a><a href="#modules">Module controls</a><a href="#simulator">TOS / FMS simulator</a><a href="#uitv">UITV telemetry</a><a href="#deliveries">Delivery monitor</a></nav><div class="sidebar-bottom"><span class="dot"></span> Operations workspace<p>FMS ↔ FOS ↔ TOS</p></div></aside>
<div class="workspace"><header><span>Operations / <strong>Integration console</strong></span><div class="header-actions"><a class="button" href="<c:url value='/admin'/>">Refresh</a><form method="post" action="<c:url value='/admin/logout'/>"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="quiet">Sign out</button></form></div></header>
<main id="overview"><div class="page-title"><div><p class="eyebrow">CONTROL CENTER</p><h1>Integration overview</h1><p class="muted">Manage modules. Follow deliveries. Test the complete round trip.</p></div><span class="pill">FOS v0.2</span></div>
<c:if test="${not empty notice}"><div class="notice" role="status"><c:out value="${notice}"/></div></c:if>
<section class="stats"><article><span>SIMULATOR</span><strong><c:out value="${simulator.state}"/></strong><small>Isolated Java TOS &amp; FMS receivers</small></article><article><span>UITV BRIDGE</span><strong><c:out value="${bridge.state}"/></strong><small>RabbitMQ input → adapted telemetry</small></article><article><span>UITV FORWARDED</span><strong><c:out value="${bridge.forwarded}"/></strong><small>Confirmed messages this process</small></article><article><span>UITV RETRIES</span><strong><c:out value="${bridge.failed}"/></strong><small>Failed processing attempts this process</small></article></section>
<section class="panel" id="modules"><div class="section-title"><div><p class="eyebrow">RUNTIME</p><h2>Module controls</h2></div><span class="muted">Changes are audited</span></div><div class="module-grid">
<c:forEach items="${modules}" var="module"><article class="module"><div class="module-heading"><h3><c:out value="${module.name == 'uitv' ? 'UITV implementation' : 'TOS / FMS simulator'}"/></h3><span class="pill"><c:out value="${module.enabled ? 'Enabled' : 'Disabled'}"/></span></div>
<p class="muted"><c:out value="${module.name == 'uitv' ? 'Convert source telemetry into the FMS business payload.' : 'Generate synthetic jobs and return execution events through FOS.'}"/></p>
<p class="fine">Available in this deployment: <strong><c:out value="${module.name == 'uitv' ? bridge.available : simulator.available}"/></strong></p>
<form method="post" action="<c:url value='/admin/modules/${module.name}'/>"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input type="hidden" name="enabled" value="${!module.enabled}"><label>Reason for change<input name="reason" maxlength="512" placeholder="e.g. Start integration test" required></label><button type="submit" class="${module.enabled ? 'secondary' : 'primary'}"><c:out value="${module.enabled ? 'Disable module' : 'Enable module'}"/></button></form><p class="fine">Last changed by <c:out value="${module.updated_by}"/> · <c:out value="${module.updated_at}"/></p></article></c:forEach></div><p class="fine">The switch stores the requested state. Runtime status above confirms whether the module is connected. Disabling stops new work; confirmed in-flight work may finish.</p></section>
<section class="panel" id="simulator"><div class="section-title"><div><p class="eyebrow">TEST LAB</p><h2>TOS / FMS simulator</h2></div><span class="pill">Synthetic traffic only</span></div><div class="flow"><span>TOS job</span><b>→</b><span>FOS</span><b>→</b><span>FMS response</span><b>→</b><span>FOS</span><b>→</b><span>TOS events</span></div><form class="inline-form" method="post" action="<c:url value='/admin/simulator/run'/>"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><label>Job count<input name="count" type="number" min="1" max="10" value="1" required></label><label>Scenario<select name="mode"><option value="SUCCESS">Successful round trip</option><option value="REJECT">FMS rejects job</option></select></label><button class="primary" type="submit">Run simulation</button></form>
<p class="fine">Successful jobs produce yard events and operation statuses 1–6 via Kafka. Refresh to see receipt and event progress.</p><div class="table-wrap"><table><thead><tr><th>Time</th><th>Message path</th><th>Message ID</th><th>Outcome</th></tr></thead><tbody><c:forEach items="${history}" var="event"><tr><td><c:out value="${event.time}"/></td><td><c:out value="${event.step}"/></td><td class="mono"><c:out value="${event.msgId}"/></td><td><c:out value="${event.result}"/></td></tr></c:forEach><c:if test="${empty history}"><tr><td colspan="4" class="empty">No simulator activity yet. Enable the simulator and run a scenario.</td></tr></c:if></tbody></table></div></section>
<section class="panel" id="uitv"><div class="section-title"><div><p class="eyebrow">TELEMETRY</p><h2>UITV transformation preview</h2></div><span class="pill">Preview does not publish</span></div><p class="muted">Check fuel / battery mapping, location and timestamp before enabling the bridge.</p><c:if test="${not empty bridge.error}"><p class="notice"><c:out value="${bridge.error}"/></p></c:if>
<form method="post" action="<c:url value='/admin/uitv/preview'/>"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><label>Source JSON<textarea name="payload" rows="9" maxlength="262144" spellcheck="false" required>{"AssetID":"SIM-EV-01","EnergySource":"ELEC","BatterySoC":"18%","Location":{"LocationName":"Operation T1"}}</textarea></label><button class="primary" type="submit">Preview Java transformation</button></form><c:if test="${not empty preview}"><h3>Transformed output</h3><pre><c:out value="${preview}"/></pre></c:if></section>
<section class="panel" id="deliveries"><div class="section-title"><div><p class="eyebrow">DURABLE DELIVERY</p><h2>Recent messages</h2></div><span class="muted">25 per page</span></div><div class="table-wrap"><table><thead><tr><th>Receipt</th><th>Type</th><th>Target</th><th>State</th><th>Attempts</th><th>Last outcome</th></tr></thead><tbody><c:forEach items="${deliveries}" var="d"><tr><td class="mono"><c:out value="${d.receipt_id}"/></td><td><c:out value="${d.message_type}"/></td><td><c:out value="${d.target}"/></td><td><span class="pill"><c:out value="${d.state}"/></span></td><td><c:out value="${d.attempt_count}"/></td><td><c:out value="${d.last_outcome}"/></td></tr></c:forEach><c:if test="${empty deliveries}"><tr><td colspan="6" class="empty">No deliveries on this page.</td></tr></c:if></tbody></table></div><div class="pagination"><c:if test="${page > 0}"><a class="button" href="?page=${page-1}#deliveries">Previous</a></c:if><span>Page <c:out value="${page+1}"/></span><c:if test="${page < 10000}"><a class="button" href="?page=${page+1}#deliveries">Next</a></c:if></div></section><footer>FOS · Integration operations &nbsp; / &nbsp; No credentials or raw delivery payloads are displayed.</footer></main></div></body></html>
