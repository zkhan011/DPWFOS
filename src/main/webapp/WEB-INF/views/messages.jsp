<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ include file="operations-header.jspf" %>
<div class="page-title"><div><p class="eyebrow">MESSAGE EXPLORER</p><h1>Message history</h1><p class="muted">Follow accepted messages from ingress through receiver responses.</p></div></div>
<section class="panel"><form id="filters" class="filter-grid" method="get"><label>Message ID, vehicle ID or receipt (exact)<input name="search" maxlength="128" value="<c:out value='${search}'/>" placeholder="e.g. T501"></label><label>Delivery state<select name="state"><option value="">All states</option><c:forEach items="${states}" var="s"><option value="${s}" ${state == s ? 'selected' : ''}><c:out value="${s}"/></option></c:forEach></select></label><label>Receiver<select name="target"><option value="">All receivers</option><option ${target == 'FMS' ? 'selected' : ''}>FMS</option><option ${target == 'TOS' ? 'selected' : ''}>TOS</option></select></label><button class="primary">Search / refresh</button><a href="<c:url value='/admin/messages'/>">Clear</a></form>
<p class="fine">Open a message for its JSON, transport metadata and complete delivery-attempt history. Rejected Kafka records are in <a href="<c:url value='/admin/kafka'/>">Kafka logs</a>.</p>
<div class="table-wrap"><table><thead><tr><th>Received</th><th>Message / vehicle</th><th>Path / type</th><th>State</th><th>Attempts</th></tr></thead><tbody><c:forEach items="${rows}" var="row"><tr><td><c:out value="${row.received_at}"/></td><td><a href="<c:url value='/admin/messages/${row.receipt_id}'/>"><c:out value="${row.msg_id}"/></a><div class="fine"><c:out value="${row.vehicle_id}"/></div></td><td><c:out value="${row.source}"/> → FOS → <c:out value="${row.target}"/><div class="fine"><c:out value="${row.message_type}"/></div></td><td><span class="pill state-${row.state}"><c:out value="${row.state}"/></span><div class="fine"><c:out value="${row.last_outcome}"/></div></td><td><c:out value="${row.attempt_count}"/></td></tr></c:forEach><c:if test="${empty rows}"><tr><td colspan="5" class="empty">No messages match these filters. Clear the filters or send a message to FOS.</td></tr></c:if></tbody></table></div><div class="pagination"><c:if test="${page > 0}"><button form="filters" name="page" value="${page-1}">Previous</button></c:if><span>Page <c:out value="${page+1}"/></span><c:if test="${hasNext and page < 10000}"><button form="filters" name="page" value="${page+1}">Next</button></c:if></div></section>
<%@ include file="operations-footer.jspf" %>
