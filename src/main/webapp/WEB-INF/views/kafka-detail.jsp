<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ include file="operations-header.jspf" %>
<a class="button" href="<c:url value='/admin/kafka'/>">← Kafka logs</a><div class="page-title"><div><p class="eyebrow">KAFKA RECORD</p><h1><c:out value="${record.topic}"/></h1><p>Partition <c:out value="${record.partition_id}"/> · Offset <c:out value="${record.offset_id}"/></p></div><span class="pill state-${record.status}"><c:out value="${record.status}"/></span></div><section class="panel"><dl class="detail-grid"><dt>Cluster</dt><dd><c:out value="${record.cluster_id}"/></dd><dt>Record key</dt><dd><c:out value="${record.record_key}"/></dd><dt>Received</dt><dd><c:out value="${record.received_at}"/></dd><dt>Kafka timestamp (epoch ms)</dt><dd><c:out value="${record.broker_timestamp}"/></dd><dt>Type / result</dt><dd><c:out value="${record.message_type}"/> / <c:out value="${record.failure_code}" default="Accepted"/></dd><dt>Payload bytes</dt><dd><c:out value="${record.payload_size}"/></dd><dt>Payload SHA-256</dt><dd class="mono"><c:out value="${record.payload_hash}"/></dd></dl><c:if test="${not empty record.receipt_id}"><a class="button" href="<c:url value='/admin/messages/${record.receipt_id}'/>">View related delivery &amp; responses</a></c:if></section><section class="panel"><h2>Consumed payload</h2><p class="fine">JSON is formatted with known credential fields masked. Non-JSON records are shown as escaped UTF-8 text; invalid byte sequences display as replacement characters.</p><pre><c:out value="${record.display_payload}"/></pre></section>
<%@ include file="operations-footer.jspf" %>
