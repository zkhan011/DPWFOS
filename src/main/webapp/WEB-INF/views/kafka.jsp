<%@ page contentType="text/html;charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ include file="operations-header.jspf" %>
<div class="page-title"><div><p class="eyebrow">EVENT STREAM</p><h1>Kafka message logs</h1><p class="muted">Durable records consumed by FOS, including rejected messages.</p></div></div>
<section class="panel"><form id="filters" class="filter-grid" method="get"><label>Record key, message ID or receipt (exact)<input name="search" maxlength="128" value="<c:out value='${search}'/>"></label><label>Topic (exact)<input name="topic" maxlength="249" value="<c:out value='${topic}'/>" placeholder="All topics"></label><label>Result<select name="status"><option value="">All results</option><option ${status == 'ACCEPTED' ? 'selected' : ''}>ACCEPTED</option><option ${status == 'QUARANTINED' ? 'selected' : ''}>QUARANTINED</option></select></label><button class="primary">Search / refresh</button><a href="<c:url value='/admin/kafka'/>">Clear</a></form>
<p class="fine">A record is logged before its offset is acknowledged. Accepted means stored by FOS; check its delivery state to confirm arrival at TOS. Re-delivery of the same cluster/topic/partition/offset does not create duplicate log entries. Logs begin with this upgrade.</p>
<div class="table-wrap"><table><thead><tr><th>Received</th><th>Topic / cluster</th><th>Partition / offset</th><th>Key</th><th>Result</th><th>Message</th></tr></thead><tbody><c:forEach items="${rows}" var="row"><tr><td><c:out value="${row.received_at}"/></td><td><a href="<c:url value='/admin/kafka/${row.log_id}'/>"><c:out value="${row.topic}"/></a><div class="fine"><c:out value="${row.cluster_id}"/></div></td><td><c:out value="${row.partition_id}"/> / <c:out value="${row.offset_id}"/></td><td class="mono"><c:out value="${row.record_key}"/></td><td><span class="pill state-${row.status}"><c:out value="${row.status}"/></span><div class="fine"><c:out value="${row.failure_code}"/></div></td><td><c:if test="${not empty row.receipt_id}"><a href="<c:url value='/admin/messages/${row.receipt_id}'/>"><c:out value="${row.msg_id}"/></a></c:if></td></tr></c:forEach><c:if test="${empty rows}"><tr><td colspan="6" class="empty">No Kafka records match these filters. Check that the Kafka listener is enabled and receiving events.</td></tr></c:if></tbody></table></div><div class="pagination"><c:if test="${page > 0}"><button form="filters" name="page" value="${page-1}">Previous</button></c:if><span>Page <c:out value="${page+1}"/></span><c:if test="${hasNext and page < 10000}"><button form="filters" name="page" value="${page+1}">Next</button></c:if></div></section>
<%@ include file="operations-footer.jspf" %>
